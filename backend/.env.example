# ─── Flask ──────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ─── Database ───────────────────────────────────
POSTGRES_USER=vzm_user
POSTGRES_PASSWORD=vzm_secret
POSTGRES_DB=vzm_db
DATABASE_URL=postgresql://vzm_user:vzm_secret@localhost:5432/vzm_db

# ─── JWT ────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES=900       # 15 minutes (seconds)
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days (seconds)
